/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in , sel=sel[0] , a=sel0 , b=sel1);

    DMux(in=sel0,  sel=sel[1] , a=sel00, b=sel01);
    DMux(in=sel1 , sel=sel[1] , a=sel10 , b=sel11);    

    DMux(in=sel00 , sel=sel[2] , a=a , b=e );
    DMux(in=sel01 , sel=sel[2] , a=c , b=g );
    DMux(in=sel10 , sel=sel[2] , a=b , b=f );
    DMux(in=sel11 , sel=sel[2] , a=d , b=h );
}
